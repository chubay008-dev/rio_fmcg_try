# --- Zalo Bot Platform (bot.zaloplatforms.com) ---
# Token của bot, lấy trong Zalo Bot Creator sau khi tạo bot.
# KHÔNG commit giá trị thật, chỉ set trong Vercel/hosting env vars.
ZALO_BOT_TOKEN=

# Chuỗi bí mật tự đặt (>= 8 ký tự), dùng để Zalo xác thực khi gọi webhook
# và để webhook route xác thực ngược lại request có đúng từ Zalo không.
ZALO_BOT_WEBHOOK_SECRET=

# Link chia sẻ công khai của bot (Zalo Bot Creator > bot của bạn > Share/Chia sẻ),
# dạng https://zalo.me/s/<bot_id>/ — hiển thị public trên nút chat nổi.
NEXT_PUBLIC_ZALO_CHAT_LINK=

# --- Supabase (public client config) ---
# Supabase project URL, lấy trong Supabase Dashboard > Settings > API.
# Public key (publishable), dùng để client-side Next.js truy vấn Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
